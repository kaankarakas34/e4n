{
  "name": "e4n2-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/config/run-versioned-schema.js",
    "test:group-capacity": "node test/group-capacity-contract.mjs",
    "test:group-roster-browser": "node test/run-group-roster-browser.mjs",
    "test:user-detail": "node test/user-detail-contract.mjs && node test/performance-context-contract.mjs",
    "test:web-acceptance": "node test/web-acceptance.mjs",
    "test:web-browser:fixture": "node test/web-browser-fixture.mjs",
    "test:web-browser": "node test/run-web-browser-acceptance.mjs",
    "test:isolated": "node test/isolated-smoke.mjs",
    "test:restore": "node test/backup-restore-rehearsal.mjs",
    "test:event-job": "node test/event-completion-contract.mjs",
    "test:champion-job": "node test/champion-calculation-contract.mjs",
    "test:subscription-reminder": "node test/subscription-reminder-contract.mjs",
    "events:completion:inspect": "node src/cron/run-event-completion.js",
    "routes:inspect": "node tools/route-ownership.mjs",
    "test:routes": "node test/route-ownership-static.mjs && node test/route-ownership-contract.mjs",
    "test:web-rehearsal": "node test/web-release-rehearsal.mjs",
    "test:guild-roster-browser": "node test/run-guild-roster-browser.mjs"
  },
  "dependencies": {
    "@types/express": "^5.0.6",
    "@types/pg": "^8.16.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.12",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node-fetch": "^2.6.13",
    "nodemon": "^3.1.0"
  }
}
