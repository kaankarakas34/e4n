@@ -0,0 +1,50 @@
+import { apiClient } from './api-client';
+
+export interface MeetingRow {
+    id: string; requester_id: string; partner_id: string; meeting_date: string; created_at: string;
+    status: string; notes: string | null; requester_name?: string; partner_name?: string; record_kind?: string;
+}
+export interface MeetingPerson { id: string; name: string }
+const text = (value: unknown) => typeof value === 'string' && !!value.trim();
+const valid = (row: any): row is MeetingRow => row && !Array.isArray(row)
+    && ['id','requester_id','partner_id','status'].every(key=>text(row[key]))
+    && ['meeting_date','created_at'].every(key=>typeof row[key]==='string' && Number.isFinite(Date.parse(row[key])))
+    && ['notes','requester_name','partner_name','record_kind'].every(key=>row[key]==null || typeof row[key]==='string');
+
+export function meetingTime(date: string, time: string) {
+    if (!/^\d{4}-\d{2}-\d{2}$/.test(date) || !/^([01]\d|2[0-3]):[0-5]\d$/.test(time)) throw new Error('Tarih ve saati kontrol edin.');
+    const value = new Date(`${date}T${time}`), [year,month,day] = date.split('-').map(Number);
+    if (!Number.isFinite(value.getTime()) || value.getFullYear()!==year || value.getMonth()+1!==month || value.getDate()!==day
+        || value.getHours()!==Number(time.slice(0,2)) || value.getMinutes()!==Number(time.slice(3))) throw new Error('Tarih ve saati kontrol edin.');
+    return value.toISOString();
+}
+export function meetingCalendar(row: MeetingRow) {
+    const stamp = (date: Date)=>date.toISOString().replace(/-|:|\.\d{3}/g,'');
+    const start = new Date(row.meeting_date), end = new Date(start.getTime()+60*60000);
+    return `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${encodeURIComponent(row.notes || 'Birebir Görüşme')}&dates=${stamp(start)}/${stamp(end)}&details=${encodeURIComponent('Event 4 Network Toplantısı')}`;
+}
+export const meetingsApi = {
+    async list(userId: string) {
+        const rows = await apiClient.get<unknown>('/one-to-ones');
+        if (!Array.isArray(rows) || !rows.every(row=>valid(row) && (row.requester_id===userId || row.partner_id===userId))) throw new Error('Toplantı listesi doğrulanamadı.');
+        return (rows as MeetingRow[]).sort((a,b)=>Number(b.status==='PENDING')-Number(a.status==='PENDING') || Date.parse(b.created_at)-Date.parse(a.created_at));
+    },
+    async people(userId: string) {
+        const rows = await apiClient.get<unknown>('/users');
+        if (!Array.isArray(rows) || !rows.every(row=>row && text(row.id) && text(row.name))) throw new Error('Üye listesi doğrulanamadı.');
+        return rows.filter(row=>row.id!==userId).map(row=>({id:row.id,name:row.name})) as MeetingPerson[];
+    },
+    async request(userId: string, receiverId: string, topic: string, proposedTime: string, requestId: string) {
+        if (!text(userId) || !text(receiverId) || userId===receiverId || !topic.trim() || !Number.isFinite(Date.parse(proposedTime))) throw new Error('Talep bilgilerini kontrol edin.');
+        const row = await apiClient.post<any>('/one-to-ones/request',{requestId,receiverId,topic:topic.trim(),proposedTime});
+        if (!valid(row) || row.id!==requestId || row.requester_id!==userId || row.partner_id!==receiverId || row.notes!==topic.trim()
+            || Date.parse(row.meeting_date)!==Date.parse(proposedTime) || !['PENDING','ACCEPTED','REJECTED'].includes(row.status)) throw new Error('Talep sonucu doğrulanamadı.');
+        return row;
+    },
+    async decide(userId: string, id: string, status: 'ACCEPTED'|'REJECTED') {
+        if (!['ACCEPTED','REJECTED'].includes(status)) throw new Error('Geçersiz karar.');
+        const row = await apiClient.put<any>(`/one-to-ones/${encodeURIComponent(id)}/status`,{status});
+        if (!valid(row) || row.id!==id || row.partner_id!==userId || row.status!==status) throw new Error('Karar sonucu doğrulanamadı.');
+        return row;
+    }
+};
