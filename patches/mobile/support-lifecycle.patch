+import React, { useEffect, useRef, useState } from 'react';
+import { ScrollView, View, Text, TextInput, TouchableOpacity, StyleSheet } from 'react-native';
+import { uuid } from 'expo-modules-core';
+import { useAuth } from '@/hooks/use-auth';
+import { supportApi, type SupportTicket, type SupportMessage } from '@/utils/support-api';
+
+const labels: Record<string,string> = {OPEN:'Açık',ANSWERED:'Cevaplandı',CLOSED:'Kapalı'};
+export function SupportWorkspace({adminOnly=false}: {adminOnly?:boolean}) {
+    const {user} = useAuth();
+    const admin = user?.role==='ADMIN';
+    const allowed = !!user?.id && (!adminOnly || admin);
+    const context = `${user?.id}:${user?.role}`;
+    const current = useRef(context); current.current=context;
+    const active = useRef(true), listSeq = useRef(0), detailSeq = useRef(0);
+    const target = useRef<SupportTicket|null>(null), lock = useRef<object|null>(null);
+    const intent = useRef<{signature:string;key:string}|null>(null);
+    const [list,setList] = useState<{context:string;rows:SupportTicket[]}|null>(null);
+    const [loading,setLoading] = useState(true), [listError,setListError] = useState('');
+    const [selection,setSelection] = useState<SupportTicket|null>(null);
+    const [detail,setDetail] = useState<{context:string;ticket:SupportTicket;messages:SupportMessage[]}|null>(null);
+    const [detailLoading,setDetailLoading] = useState(false), [detailError,setDetailError] = useState('');
+    const [subject,setSubject] = useState(''), [message,setMessage] = useState(''), [reply,setReply] = useState('');
+    const [pending,setPending] = useState(false), [notice,setNotice] = useState<{error:boolean;text:string}|null>(null);
+    const valid = () => allowed && active.current && current.current===context;
+    const loadList = async () => {
+        if(!valid())return;
+        const seq=++listSeq.current;setLoading(true);setListError('');
+        try{const rows=await supportApi.list(user.id,admin);if(valid() && seq===listSeq.current){setList({context,rows});if(target.current && !rows.some(row=>row.id===target.current?.id))close();}}
+        catch{if(valid() && seq===listSeq.current){setListError('Destek talepleri yüklenemedi.');setList({context,rows:[]});}}
+        finally{if(valid() && seq===listSeq.current)setLoading(false);}
+    };
+    const loadDetail = async (row:SupportTicket) => {
+        if(!valid())return;
+        if(target.current?.id!==row.id){setReply('');setNotice(null);}
+        target.current=row;setSelection(row);
+        const seq=++detailSeq.current;setDetailLoading(true);setDetailError('');setDetail(null);
+        try{const result=await supportApi.detail(row.id,row.user_id);if(valid() && seq===detailSeq.current && target.current?.id===row.id)setDetail({...result,context});}
+        catch{if(valid() && seq===detailSeq.current && target.current?.id===row.id)setDetailError('Talep detayları yüklenemedi.');}
+        finally{if(valid() && seq===detailSeq.current && target.current?.id===row.id)setDetailLoading(false);}
+    };
+    useEffect(()=>{
+        active.current=true;target.current=null;setSelection(null);setDetail(null);setReply('');setSubject('');setMessage('');setNotice(null);setPending(false);
+        if(allowed)void loadList();
+        return()=>{active.current=false;listSeq.current++;detailSeq.current++;target.current=null;};
+    },[context,allowed]);
+    const close = () => {detailSeq.current++;target.current=null;setSelection(null);setDetail(null);setReply('');setNotice(null);setDetailError('');setDetailLoading(false);};
+    const run = async (kind:'create'|'reply'|'status',status?:'OPEN'|'CLOSED') => {
+        if(!valid() || lock.current || (kind==='status' && !admin))return;
+        const row=detail?.context===context?detail.ticket:null;
+        if(kind!=='create' && (!row || detailLoading || detailError || loading || listError || target.current?.id!==row.id))return;
+        if(kind==='create' && (!subject.trim() || !message.trim()))return;
+        if(kind==='reply' && (!reply.trim() || !labels[row!.status] || (!admin && row!.status==='CLOSED')))return;
+        const version=detailSeq.current, token={};lock.current=token;setPending(true);setNotice(null);
+        const isCurrent=()=>valid() && (kind==='create' || (version===detailSeq.current && target.current?.id===row?.id));
+        const signature=JSON.stringify([context,kind,kind==='create'?null:row?.id,kind==='create'?subject.trim():null,kind==='status'?status:kind==='create'?message.trim():reply.trim()]);
+        try {
+            if(intent.current?.signature!==signature)intent.current={signature,key:uuid.v4()};
+            const key=intent.current.key;
+            if(kind==='create')await supportApi.create(user.id,subject.trim(),message.trim(),key);
+            else if(kind==='reply')await supportApi.reply(row!.id,reply.trim(),key);
+            else await supportApi.status(row!.id,status!,key);
+            if(!isCurrent())return;
+            if(intent.current?.key===key)intent.current=null;
+            if(kind==='create'){setSubject('');setMessage('');}else if(kind==='reply')setReply('');
+            setNotice({error:false,text:'İşlem kaydedildi. Yenileme hatasında yalnızca tekrar yükleyin.'});
+            await Promise.all([loadList(),...(kind==='create'?[]:[loadDetail(row!)])]);
+        }catch{if(isCurrent())setNotice({error:true,text:'İşlem sonucu doğrulanamadı. Tekrar göndermeden talepleri kontrol edin; aynı giriş aynı işlem anahtarını kullanır.'});}
+        finally{if(lock.current===token){lock.current=null;if(valid())setPending(false);}}
+    };
+    const button = (title:string,onPress:()=>void,disabled=false) => <TouchableOpacity accessibilityRole="button" accessibilityLabel={title} onPress={onPress} disabled={disabled} style={[styles.button,disabled&&styles.disabled]}><Text style={styles.buttonText}>{title}</Text></TouchableOpacity>;
+    if(!allowed)return <Text>{user?.id?'Erişim reddedildi.':'Destek için giriş yapın.'}</Text>;
+    const fresh=list?.context===context;
+    const selected=fresh && detail?.context===context && detail.ticket.id===selection?.id?detail:null;
+    return <ScrollView contentContainerStyle={styles.container} keyboardShouldPersistTaps="handled">
+        <Text style={styles.title}>{admin?'Destek Yönetimi':'Destek Taleplerim'}</Text>
+        {notice && fresh && <Text accessibilityRole={notice.error?'alert':'text'}>{notice.text}</Text>}
+        {!fresh || loading?<Text>Destek talepleri yükleniyor...</Text>:listError?<View><Text accessibilityRole="alert">{listError}</Text>{button('Talepleri tekrar yükle',()=>loadList(),pending)}</View>:<View>
+            {button('Talepleri tekrar yükle',()=>loadList(),pending)}
+            {!list.rows.length && <Text>Destek talebi bulunmuyor.</Text>}
+            {list.rows.map(row=><TouchableOpacity key={row.id} accessibilityRole="button" accessibilityLabel={`Talep: ${row.subject}`} disabled={pending} onPress={()=>loadDetail(row)} style={styles.card}><Text>{row.subject}</Text>{admin&&<Text>{row.user_name || 'İsim bilgisi yok'}</Text>}<Text>{labels[row.status] || 'Bilinmeyen durum'}</Text><Text>{row.last_message || 'Mesaj yok'}</Text></TouchableOpacity>)}
+        </View>}
+        {fresh && selection && !loading && !listError && <View style={styles.card}>
+            {button('Detayı kapat',close,pending)}
+            {detailLoading?<Text>Talep detayları yükleniyor...</Text>:detailError?<View><Text accessibilityRole="alert">{detailError}</Text>{button('Detayı tekrar yükle',()=>loadDetail(selection),pending)}</View>:selected&&<View>
+                <Text style={styles.title}>{selected.ticket.subject}</Text><Text>{labels[selected.ticket.status] || 'Bilinmeyen durum'}</Text>
+                {!selected.messages.length && <Text>Bu talepte henüz mesaj yok.</Text>}
+                {selected.messages.map(item=><View key={item.id} style={styles.message}><Text>{item.sender_name || 'İsim bilgisi yok'} · {item.sender_role}</Text><Text>{item.message}</Text><Text>{new Date(item.created_at).toLocaleString('tr-TR')}</Text></View>)}
+                {(admin || selected.ticket.status!=='CLOSED') && <View><TextInput accessibilityLabel="Yanıt" placeholder="Yanıtınız" multiline value={reply} onChangeText={setReply} editable={!pending} maxLength={10000} style={styles.input}/>{button('Yanıt gönder',()=>run('reply'),pending || !reply.trim() || !labels[selected.ticket.status])}</View>}
+                {admin && labels[selected.ticket.status] && button(selected.ticket.status==='CLOSED'?'Tekrar aç':'Talebi kapat',()=>run('status',selected.ticket.status==='CLOSED'?'OPEN':'CLOSED'),pending)}
+            </View>}
+        </View>}
+        {fresh && !admin && <View style={styles.card}><Text style={styles.title}>Yeni Destek Talebi</Text>
+            <TextInput accessibilityLabel="Konu" placeholder="Konu" value={subject} onChangeText={setSubject} editable={!pending} maxLength={255} style={styles.input}/>
+            <TextInput accessibilityLabel="Mesaj" placeholder="Mesajınız" multiline value={message} onChangeText={setMessage} editable={!pending} maxLength={10000} style={styles.input}/>
+            {button('Talep oluştur',()=>run('create'),pending || !subject.trim() || !message.trim())}
+        </View>}
+    </ScrollView>;
+}
+const styles=StyleSheet.create({container:{padding:20,gap:16,backgroundColor:'#f8fafc'},title:{fontSize:20,fontWeight:'bold',color:'#1e293b'},card:{padding:16,gap:10,backgroundColor:'white',borderRadius:12,marginVertical:6},message:{padding:12,backgroundColor:'#eff6ff',borderRadius:8,marginVertical:4},input:{borderWidth:1,borderColor:'#cbd5e1',padding:12,borderRadius:8,minHeight:48},button:{backgroundColor:'#475569',padding:14,borderRadius:8,marginVertical:6},buttonText:{color:'white',textAlign:'center'},disabled:{opacity:0.5}});
