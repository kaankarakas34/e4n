+++ b/utils/support-api.ts
@@ -0,0 +1,45 @@
+import { apiClient } from './api-client';
+
+export interface SupportTicket {
+    id: string; user_id: string; subject: string; status: string; created_at: string; updated_at: string;
+    user_name?: string; user_email?: string; last_message?: string;
+}
+export interface SupportMessage {
+    id: string; ticket_id: string; sender_id: string; message: string; sender_role: string; created_at: string; sender_name?: string;
+}
+const nonempty = (value: unknown) => typeof value === 'string' && !!value.trim();
+const date = (value: unknown) => typeof value === 'string' && Number.isFinite(Date.parse(value));
+const ticket = (row: any): row is SupportTicket => row && !Array.isArray(row)
+    && nonempty(row.id) && nonempty(row.user_id) && typeof row.subject === 'string' && nonempty(row.status)
+    && date(row.created_at) && date(row.updated_at)
+    && ['user_name','user_email','last_message'].every(key=>row[key]==null || typeof row[key]==='string');
+export const supportApi = {
+    async list(userId: string, admin: boolean) {
+        const rows = await apiClient.get<unknown>('/tickets');
+        if (!Array.isArray(rows) || !rows.every(row=>ticket(row) && (admin || row.user_id===userId))) throw new Error('Destek listesi doğrulanamadı.');
+        return rows as SupportTicket[];
+    },
+    async detail(id: string, owner: string) {
+        const result = await apiClient.get<any>(`/tickets/${id}`);
+        if (!ticket(result?.ticket) || result.ticket.id!==id || result.ticket.user_id!==owner || !Array.isArray(result.messages)
+            || !result.messages.every((row: any)=>row && !Array.isArray(row) && row.ticket_id===id && nonempty(row.id) && nonempty(row.sender_id)
+                && typeof row.message==='string' && nonempty(row.sender_role) && date(row.created_at) && (row.sender_name==null || typeof row.sender_name==='string')))
+            throw new Error('Destek detayı doğrulanamadı.');
+        return result as {ticket:SupportTicket;messages:SupportMessage[]};
+    },
+    async create(userId: string, subject: string, message: string, requestKey: string) {
+        const result = await apiClient.post<any>('/tickets',{subject,message,requestKey});
+        if (!ticket(result) || result.user_id!==userId || result.subject!==subject || result.status!=='OPEN') throw new Error('Talep oluşturma sonucu doğrulanamadı.');
+        return result;
+    },
+    async reply(id: string, message: string, requestKey: string) {
+        const result = await apiClient.post<any>(`/tickets/${id}/messages`,{message,requestKey});
+        if (result?.success!==true || result.ticket_id!==id || !nonempty(result.message_id) || !['OPEN','ANSWERED'].includes(result.status)) throw new Error('Yanıt doğrulanamadı.');
+        return result;
+    },
+    async status(id: string, status: 'OPEN'|'CLOSED', requestKey: string) {
+        const result = await apiClient.put<any>(`/tickets/${id}/status`,{status,requestKey});
+        if (result?.success!==true || result.ticket_id!==id || result.status!==status) throw new Error('Durum doğrulanamadı.');
+        return result;
+    }
+};
