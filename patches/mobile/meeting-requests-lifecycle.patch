+import React, { useEffect, useRef, useState } from 'react';
+import { ScrollView, View, Text, TextInput, TouchableOpacity, StyleSheet, Linking } from 'react-native';
+import { uuid } from 'expo-modules-core';
+import { useAuth } from '@/hooks/use-auth';
+import { meetingsApi, meetingTime, meetingCalendar, type MeetingRow, type MeetingPerson } from '@/utils/meetings-api';
+
+const labels: Record<string,string> = {PENDING:'Bekliyor',ACCEPTED:'Onaylandı',REJECTED:'Reddedildi',COMPLETED:'Tamamlandı'};
+export default function MeetingRequestsScreen() {
+    const {user} = useAuth(), context = `${user?.id}:${user?.role}`;
+    const current = useRef(context), generation = useRef(0), active = useRef(true);
+    if (current.current!==context) { current.current=context; generation.current++; }
+    const version = generation.current, valid = ()=>active.current && current.current===context && generation.current===version && !!user?.id;
+    const listSeq = useRef(0), peopleSeq = useRef(0), lock = useRef<object|null>(null);
+    const intent = useRef<{signature:string;id:string}|null>(null);
+    const [list,setList] = useState<{context:string;rows:MeetingRow[]}|null>(null);
+    const [people,setPeople] = useState<{context:string;rows:MeetingPerson[]}|null>(null);
+    const [loading,setLoading] = useState(false), [peopleLoading,setPeopleLoading] = useState(false);
+    const [error,setError] = useState<string|null>(null), [peopleError,setPeopleError] = useState<string|null>(null);
+    const [notice,setNotice] = useState<{context:string;text:string}|null>(null), [pendingFor,setPendingFor] = useState<string|null>(null);
+    const [receiver,setReceiver] = useState(''), [topic,setTopic] = useState(''), [date,setDate] = useState(''), [time,setTime] = useState('');
+    const pending = pendingFor===context;
+    const load = async()=>{
+        if(!valid())return;
+        const seq=++listSeq.current;setLoading(true);setError(null);
+        try { const rows=await meetingsApi.list(user.id);if(valid()&&seq===listSeq.current)setList({context,rows}); }
+        catch {if(valid()&&seq===listSeq.current){setList({context,rows:[]});setError('Toplantı talepleri yüklenemedi.');}}
+        finally {if(valid()&&seq===listSeq.current)setLoading(false);}
+    };
+    const loadPeople = async()=>{
+        if(!valid())return;
+        const seq=++peopleSeq.current;setPeopleLoading(true);setPeopleError(null);
+        try {const rows=await meetingsApi.people(user.id);if(valid()&&seq===peopleSeq.current){setPeople({context,rows});if(!rows.some(row=>row.id===receiver))setReceiver('');}}
+        catch {if(valid()&&seq===peopleSeq.current){setPeople({context,rows:[]});setPeopleError('Üyeler yüklenemedi.');}}
+        finally {if(valid()&&seq===peopleSeq.current)setPeopleLoading(false);}
+    };
+    useEffect(()=>{
+        active.current=true;setList(null);setPeople(null);setReceiver('');setTopic('');setDate('');setTime('');setNotice(null);setPendingFor(null);intent.current=null;
+        void load();void loadPeople();
+        return ()=>{active.current=false;listSeq.current++;peopleSeq.current++;};
+    },[context]);
+    const ready=list?.context===context&&!loading&&!error;
+    const peopleReady=people?.context===context&&!peopleLoading&&!peopleError;
+    const listVersion=listSeq.current;
+    const run = async(status?:'ACCEPTED'|'REJECTED',row?:MeetingRow)=>{
+        if(!valid() || lock.current)return;
+        if(status && (!ready || listVersion!==listSeq.current || !row || row.partner_id!==user.id || row.status!=='PENDING'))return;
+        if(!status && (!peopleReady || !receiver || !people!.rows.some(person=>person.id===receiver) || !topic.trim()))return;
+        let proposedTime='';
+        if(!status){try{proposedTime=meetingTime(date,time);}catch{setNotice({context,text:'Konu, tarih ve saati kontrol edin.'});return;}}
+        const token={};lock.current=token;setPendingFor(context);setNotice(null);
+        try {
+            if(status)await meetingsApi.decide(user.id,row!.id,status);
+            else {
+                const signature=JSON.stringify([context,receiver,topic.trim(),proposedTime]);
+                if(intent.current?.signature!==signature)intent.current={signature,id:uuid.v4()};
+                await meetingsApi.request(user.id,receiver,topic.trim(),proposedTime,intent.current.id);
+            }
+            if(!valid())return;
+            if(!status){intent.current=null;setReceiver('');setTopic('');setDate('');setTime('');}
+            setNotice({context,text:status?(status==='ACCEPTED'?'Talep onaylandı.':'Talep reddedildi.'):'Toplantı talebi gönderildi.'});
+            await load();
+        } catch {if(valid())setNotice({context,text:'İşlem sonucu doğrulanamadı. Listeyi yenileyip kontrol edin; aynı talep bilgileriyle yeniden deneyebilirsiniz.'});}
+        finally {if(lock.current===token){lock.current=null;if(valid())setPendingFor(null);}}
+    };
+    const calendar = async(row:MeetingRow)=>{
+        if(!valid()||!ready||row.status!=='ACCEPTED')return;
+        try{await Linking.openURL(meetingCalendar(row));}catch{if(valid())setNotice({context,text:'Takvim bağlantısı açılamadı.'});}
+    };
+    const button=(label:string,onPress:()=>void,disabled=false)=><TouchableOpacity accessibilityRole="button" accessibilityLabel={label} onPress={onPress} disabled={disabled} style={[styles.button,disabled&&styles.disabled]}><Text style={styles.buttonText}>{label}</Text></TouchableOpacity>;
+    if(!user?.id)return <Text>Toplantı talepleri için giriş yapın.</Text>;
+    return <ScrollView contentContainerStyle={styles.container} keyboardShouldPersistTaps="handled">
+        <Text style={styles.title}>Toplantı Talepleri</Text>
+        {notice?.context===context&&<Text accessibilityRole="alert">{notice.text}</Text>}
+        {button('Talepleri yenile',load,pending||loading)}
+        {loading||list?.context!==context?<Text>Talepler yükleniyor...</Text>:error?<Text accessibilityRole="alert">{error}</Text>:<View>
+            {!list.rows.length&&<Text>Henüz toplantı talebi veya görüşme kaydı bulunmuyor.</Text>}
+            {list.rows.map(row=><View key={row.id} style={styles.card}>
+                <Text>{row.record_kind==='REQUEST'?'Toplantı talebi':row.record_kind==='ACTIVITY'?'Görüşme kaydı':'Kayıt türü bilinmiyor'} · {row.partner_id===user.id?'Gelen':'Giden'}</Text>
+                <Text style={styles.title}>{row.notes||'Birebir Görüşme'}</Text>
+                <Text>{row.partner_id===user.id?(row.requester_name||row.requester_id):(row.partner_name||row.partner_id)}</Text>
+                <Text>{new Date(row.meeting_date).toLocaleString('tr-TR')} · {labels[row.status]||'Bilinmeyen durum'}</Text>
+                {row.partner_id===user.id&&row.status==='PENDING'&&<View>{button(`Kabul et: ${row.id}`,()=>run('ACCEPTED',row),pending)}{button(`Reddet: ${row.id}`,()=>run('REJECTED',row),pending)}</View>}
+                {row.status==='ACCEPTED'&&button(`Takvime ekle: ${row.id}`,()=>calendar(row),pending)}
+            </View>)}
+        </View>}
+        <View style={styles.card}><Text style={styles.title}>Yeni Toplantı Talebi</Text>
+            {button('Üyeleri yenile',loadPeople,pending||peopleLoading)}
+            {peopleLoading||people?.context!==context?<Text>Üyeler yükleniyor...</Text>:peopleError?<Text accessibilityRole="alert">{peopleError}</Text>:<View>
+                {!people.rows.length&&<Text>Talep gönderilebilecek üye bulunmuyor.</Text>}
+                {people.rows.map(person=><TouchableOpacity key={person.id} accessibilityRole="button" accessibilityLabel={`Üye: ${person.name}`} accessibilityState={{selected:receiver===person.id}} disabled={pending} onPress={()=>{if(valid()&&!lock.current)setReceiver(person.id);}} style={styles.person}><Text>{receiver===person.id?'✓ ':''}{person.name}</Text></TouchableOpacity>)}
+            </View>}
+            <TextInput accessibilityLabel="Toplantı konusu" placeholder="Toplantı konusu" value={topic} onChangeText={setTopic} editable={!pending} maxLength={10000} style={styles.input}/>
+            <TextInput accessibilityLabel="Toplantı tarihi" placeholder="Tarih: YYYY-AA-GG" value={date} onChangeText={setDate} editable={!pending} maxLength={10} style={styles.input}/>
+            <TextInput accessibilityLabel="Toplantı saati" placeholder="Yerel saat: SS:DD" value={time} onChangeText={setTime} editable={!pending} maxLength={5} style={styles.input}/>
+            {button('Toplantı talebi gönder',()=>run(),pending||!peopleReady||!receiver||!topic.trim()||!date||!time)}
+        </View>
+    </ScrollView>;
+}
+const styles=StyleSheet.create({container:{padding:20,backgroundColor:'#f8fafc'},title:{fontSize:20,fontWeight:'bold',color:'#1e293b'},card:{padding:16,gap:10,backgroundColor:'white',borderRadius:12,marginVertical:8},person:{padding:12,backgroundColor:'#e2e8f0',marginVertical:3},input:{borderWidth:1,borderColor:'#cbd5e1',padding:12,borderRadius:8},button:{padding:14,backgroundColor:'#475569',borderRadius:8,marginVertical:6},buttonText:{color:'white',textAlign:'center'},disabled:{opacity:0.5}});
